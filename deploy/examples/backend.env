# Example for a server set up by hand (see ../MANUAL_INSTALL.md): the lines of
# backend/.env that differ from backend/.env.example. Copy .env.example to .env first,
# then change these.

APP_ENV=production
APP_DEBUG=false
PORT=8181
APP_URL=example.com

# Outside the checkout, in a folder the API user can write: SQLite adds -wal and -shm files next to it
DATABASE_PATH=/var/www/gogobackup/shared/database/gogobackup.db

LOG_FORMAT=json
# supervisor collects stdout into /var/log/gogobackup
LOG_OUTPUT=stdout

# openssl rand -hex 32
JWT_SECRET=

# openssl rand -base64 32. Keep a copy elsewhere: without it, stored storage credentials are unreadable.
ENCRYPTION_KEY=

FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
# nginx on this machine is the only proxy in front of the API
TRUSTED_PROXIES=127.0.0.1,::1

# The API runs the scheduled jobs and the backups. Set false and run bin/gogo-cron under supervisor to split them out.
ENABLE_SCHEDULER=true
# How many backups and restores run at once
RUNNER_CONCURRENCY=2
# Restores download and extract here; it needs room for the largest Postgres archive
WORK_DIR=/var/www/gogobackup/shared/work
# Parallel jobs of pg_restore
RESTORE_JOBS=4
