# SQLite database file; its directory is created on start
DATABASE_PATH=./data/gogobackup.db

# Database for --test-db and `cli --test` (the E2E suite). The file name must end in _test.db.
# `go test` does not use it: every test gets its own temporary database.
TEST_DATABASE_PATH=./data/gogobackup_test.db

# Server Configuration
PORT=8181
APP_URL=localhost:8181

# Application Environment
APP_ENV=development
APP_NAME=Gogobackup
APP_DEBUG=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=both # Options: stdout, stderr, both, or file path like "logs/app.log"

# CORS: comma-separated origins. Empty or * allows any origin (fine for local development)
CORS_ALLOWED_ORIGINS=

# JWT secret (required). With APP_ENV=production the API refuses to start on this placeholder
# or on anything shorter than 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=720h

# Encrypts storage credentials in the database: 32 random bytes in base64. Generate one with:
#   openssl rand -base64 32
# Empty uses a public development key (with a warning at start); APP_ENV=production refuses to start
# without a real one. Losing or changing the key makes the stored credentials unreadable.
ENCRYPTION_KEY=

# Auth
# Open POST /auth/register to anyone. Off by default: accounts are created by admins.
ALLOW_REGISTRATION=false
# Throttle login, refresh and the emailed-link endpoints
AUTH_RATE_LIMIT=true
# Base URL of the links in password reset and email verification mails
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=48h
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Mail (SMTP). With APP_DEBUG=true mail is logged instead of sent.
# MAIL_SCHEME: smtp (STARTTLS), smtps (implicit TLS) or none (plain, local catchers such as Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Gogobackup"

# Run the scheduled jobs and the backups inside the API process. Set false when bin/gogo-cron
# runs them instead.
ENABLE_SCHEDULER=true
# How many backups and restores run at once. A plan runs one at a time.
RUNNER_CONCURRENCY=2
# Where restores download archives (a Postgres restore needs room for the whole archive) and
# extract files by default
WORK_DIR=./data/work
# Parallel jobs of pg_restore
RESTORE_JOBS=4
