# SQLite database file; its directory is created on start
DATABASE_PATH=./data/goptimizer.db

# Database for --test-db and `cli --test` (the E2E suite). The file name must end in _test.db.
# `go test` does not use it: every test gets its own temporary database.
TEST_DATABASE_PATH=./data/goptimizer_test.db

# Server Configuration
PORT=8747
# The address the API listens on. Empty is every interface, except with APP_ENV=production, where it
# is 127.0.0.1 so only nginx on the same machine reaches the API; 0.0.0.0 is every interface there.
BIND_ADDRESS=
APP_URL=localhost:8747

# Application Environment
APP_ENV=development
APP_NAME=Goptimizer
APP_DEBUG=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=both # Options: stdout, stderr, both, or file path like "logs/app.log"

# CORS: comma-separated origins. Empty or * allows any origin (fine for local development)
CORS_ALLOWED_ORIGINS=

# JWT secret (required). With APP_ENV=production the API refuses to start on this placeholder
# or on anything shorter than 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=720h

# Auth
# Open POST /auth/register to anyone. Off by default: accounts are created by admins.
ALLOW_REGISTRATION=false
# Throttle login, refresh and the emailed-link endpoints
AUTH_RATE_LIMIT=true
# Base URL of the links in password reset and email verification mails
FRONTEND_URL=http://localhost:5747
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=48h
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Mail (SMTP). With APP_DEBUG=true mail is logged instead of sent.
# MAIL_SCHEME: smtp (STARTTLS), smtps (implicit TLS) or none (plain, local catchers such as Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Goptimizer"

# Run the scheduled jobs inside the API process. Set false when bin/goptimizer-cron runs them instead.
ENABLE_SCHEDULER=true

# Where the optimizer's tools work on copies of images. Empty is a directory under the OS temp dir,
# named after the database. On a server use a directory of its own, such as /var/lib/goptimizer/work:
# the API refuses to start when another user owns the directory or can use it.
WORK_DIR=
