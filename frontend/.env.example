# The API with its /api/v1 prefix. A full URL in development, /api/v1 behind nginx in production.
VITE_API_URL=http://localhost:8747/api/v1

# App
VITE_APP_NAME=Goptimizer
VITE_APP_VERSION=1.0.0

# E2E / Playwright
TEST_FRONTEND_PORT=5748
TEST_BACKEND_PORT=8748
# TEST_DATABASE_PATH comes from ../backend/.env; set it here only to override it.
